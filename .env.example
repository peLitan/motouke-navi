# 要る項目の名前だけを並べています。値はここにもソースにも書かず、使う人の端末の環境変数で渡してください。
# どのプログラムも .env を自動では読みません。
# tools/claude-check.mjs が読む Claude の API の鍵
ANTHROPIC_API_KEY=
# 任意: integration/claude-code/ の道具 masked-files が使う、このツールのフォルダ
MASK_TOOL_DIR=
# 任意: 道具 read_masked が使う対応表のファイル(画面の「対応表を書き出す」で保存したもの)
MASK_MAP=
# 任意: 道具 read_masked が使う辞書のファイル(画面の「辞書を書き出す」で保存したもの)
MASK_DICT=
